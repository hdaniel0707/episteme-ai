# ============================================================================
# workflow/config.yaml — THE training configuration file.
#
# This file + .env.workflow are the ONLY two files you edit to set up trainings:
#   * config.yaml    (this file)  — WHAT to train: workflow, target, classes,
#                                   model, hyperparameters, and the `runs:` queue.
#   * .env.workflow               — HOW the machine runs it: parallelism, GPU
#                                   batch size, force-recompute flags. Nothing
#                                   there changes the science of a run.
#
#   python -m workflow.run_pipeline        -> runs ONE workflow using the
#                                             top-level keys below.
#   python -m workflow.run_all_workflows   -> runs EVERY entry in `runs:` at the
#                                             bottom, each inheriting the
#                                             top-level keys and applying its own
#                                             overrides. Output folders are
#                                             auto-indexed: emb_clf_1, emb_clf_2, …
#
# Every key in sections 1-6 can also be used inside a `runs:` entry to override
# it for that run only.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. WHAT TO RUN  (the keys you change most often)
# ---------------------------------------------------------------------------
# workflow: which pipeline topology run_pipeline executes. One of:
#   emb_clf          frozen embedding -> encoder -> MLP classifier
#   emb_reg          frozen embedding -> encoder -> MLP regressor
#   emb_meta_clf     + fused metadata / novelty / feasibility features
#   emb_meta_reg
#   emb_all_meta_clf ALL numeric columns incl. target inputs (leakage upper bound)
#   emb_all_meta_reg
#   tfm_clf          fine-tune a text transformer directly on title+abstract
#   tfm_reg
#   all              run every topology once, sharing the common phases
workflow: emb_clf

n_runs: 5              # seeds per run (model seed varies; the data split never does)
model_seed: 42         # base seed; seed i trains with model_seed + i

# Number of impact classes (classification + the class-binned regression plots).
# Set exactly ONE of the three knobs below — first one set wins (2..25 classes):
#   class_distribution: [15, 35, 35, 15]   # per-class % shares (uneven allowed)
#   num_classes: 4                         # equal-sized classes -> Q4..Q1
#   class_thresholds: [0.25, 0.50, 0.75]   # manual [0,1] boundaries (N -> N+1 classes)
class_thresholds: [0.25, 0.50, 0.75]
# class_names: [Q4, Q3, Q2, Q1]  # optional; auto-derived (Qn..Q1) when omitted
class_scheme: percentile          # percentile | css (cluster-based boundaries)

# Impact target regressed / classified:
#   field_year_percentile | fwci_percentile | normalized_percentile | bayesian_impact
target_kind: field_year_percentile

# ---------------------------------------------------------------------------
# 2. MODEL & TRAINING  (the impact-predictor head; ignored by tfm_* workflows)
# ---------------------------------------------------------------------------
model_arch: mlp        # mlp | resmlp | ft_transformer
hidden: [256, 128]     # hidden sizes per layer (mlp AND resmlp honor the full list;
                       # resmlp: one residual block per entry, projections between widths)
activation: gelu       # relu | gelu | tanh | htanh | sigmoid | leaky_relu | elu | silu | mish
dropout: 0.5
lr: 0.0005
weight_decay: 0.02
max_epochs: 2000       # early stopping usually ends training long before this
patience: 60           # epochs without val improvement before stopping
batch_size: 128

# Classifier loss (ignored by regression):
class_weight: effective  # none | balanced (inverse-freq) | effective (Cui 2019)
effective_beta: 0.999    # beta for the 'effective' class-balanced scheme
loss: ce                 # ce | focal
focal_gamma: 2.0         # focal-loss focusing parameter (only when loss: focal)
label_smoothing: 0.05    # 0..~0.1; calms over-confident softmax

# ---------------------------------------------------------------------------
# 3. EMBEDDING & ENCODER  (emb_* workflows only)
# ---------------------------------------------------------------------------
embedder: specter2     # specter2 | scibert | scincl | e5 | openai — the frozen embedding
                       # (sets both the computed embedding and the one fed to the encoder;
                       #  use `embedders: [a, b]` + `embed_for_encoder: a` to compute extras)
encoder_kind: identity # identity (no reduction) | autoencoder | pca | umap
dim_grid: [64, 128, 256, 512]   # candidate latent dims for k* selection
dim_recon_target: 0.95 # autoencoder: smallest k with reconstruction R^2 >= this
dim_tolerance: 0.01    # probe-metric tolerance when no reconstruction is available
encoder_max_epochs: 600
encoder_patience: 40

# ---------------------------------------------------------------------------
# 4. TEXT TRANSFORMER  (tfm_* workflows only)
# ---------------------------------------------------------------------------
text_transformer_arch: specter2_ft  # specter2_ft | scibert_ft | specter2_lora | scibert_lora
text_transformer_lr: 2.0e-5
text_transformer_epochs: 5
text_transformer_warmup_ratio: 0.06
text_transformer_batch_size: 16     # micro-batch; grad-accum keeps effective batch 64
text_transformer_max_len: 256       # token cap for title+abstract
text_transformer_freeze_layers: 10  # freeze first N encoder layers (0 = train all)
text_transformer_n_runs: 2          # seeds for tfm runs (GPU-heavy; fewer than n_runs)
text_transformer_lora_r: 8          # LoRA rank / alpha / dropout (only *_lora arches)
text_transformer_lora_alpha: 16
text_transformer_lora_dropout: 0.1

# ---------------------------------------------------------------------------
# 5. METADATA FEATURES  (emb_meta_* / emb_all_meta_* workflows)
# ---------------------------------------------------------------------------
use_metadata: true
metadata_fields: [best_author_h_index, author_count, venue]
use_novelty: true        # embedding novelty score (see novelty_kind)
use_feasibility: true    # precedent/density/maturity feasibility composite (0-1)
novelty_kind: spherical  # spherical (geodesic kNN distance, percentile 0-1) | cosine_max (legacy)
novelty_k: 10            # kNN size for the novelty/feasibility geometry
# Frozen external baseline scorers, fused as features AND dumped to
# results/<run>/baselines.parquet for the comparison plots (phase 7):
#   naip | naip_local | specter2_knn | llm_judge | venue_ais | forecite | cited_potential
# llm_judge needs an API key (LLM_JUDGE_PROVIDER/MODEL in .env.workflow, key in .env);
# venue_ais needs the UEFISCDI xlsx/pdf lists under workflow/data/;
# naip_local needs weights (python -m workflow.src.setup_external_models) + peft;
# every scorer degrades to None gracefully when unavailable, runs never crash.
# Default ON: the two fully-offline scorers (cached per paper_id, cheap after run 1).
external_impact: [specter2_knn, venue_ais]

# Benchmark suites evaluated for every run at phase 7 (aggregate/model_benchmarks/):
#   holdout_extended  local, built by `main_extend_db extend` — no network needed
#   holdout_recent    local recent-years temporal holdout, also built by extend
#   naip12k           downloaded NAIP dataset (evaluation.benchmarks.download_benchmark)
#   sciimpact_pairs | dblp_v14_sample   optional, download first
# Each benchmark gets its own figure + CSV in aggregate/model_benchmarks/.
benchmarks: [holdout_extended, holdout_recent]

# ---------------------------------------------------------------------------
# 6. DATA & SPLIT  (rarely changed — changing these invalidates cached parquets)
# ---------------------------------------------------------------------------
dataset_id: wf01
split_seed: 45
split_ratios: [0.70, 0.15, 0.15]   # train / val / test — ONE shared split for all stages
target_min_refset: 30              # min (field x year) papers before pooling
# year_from: 2015                  # optional corpus filters
# year_to: 2023
# max_papers: 2000                 # cap corpus size for quick tests

# ---------------------------------------------------------------------------
# 6b. DATA EXTENSION  (python -m workflow.src.main_extend_db — plan §4)
# ---------------------------------------------------------------------------
# Grows the workflow-owned extended DB (workflow/data/sql/extended.db) toward
# fetch_target_rows real papers from OpenAlex + UEFISCDI journal seeds; the
# professor's store/ DBs are read-only. Point the pipeline at the result with
# EPAI_DB=extended in workflow/.env.workflow.
fetch_target_rows: 100000
# fetch_year_from: 2010
# fetch_year_to: 2024
fetch_per_journal_cap: 300     # max papers per UEFISCDI red/yellow journal
# OpenAlex domain balance: one filter string per bucket (empty list = no bucketing).
# Field ids: https://api.openalex.org/fields  (e.g. computer science=17, medicine=27)
fetch_domains: []
# fetch_domains:
#   - primary_topic.field.id:fields/17
#   - primary_topic.field.id:fields/27

# ============================================================================
# 7. RUNS — the training queue for `python -m workflow.run_all_workflows`
# ============================================================================
# Each entry = one training setup. Keys:
#   name       label shown in the progress display and logs (required)
#   workflow   one topology, or a list to run several with the same params
#   ...        ANY key from sections 1-6 above, overriding it for this run only
#
# Runs execute in order. Expensive shared phases (fetch/prepare/embed/encode)
# are computed once and reused between runs with identical data/embedding
# parameters. Every run writes to its own auto-indexed results folder.
#
# --- TEMPLATE — copy, rename, un-comment, edit ------------------------------
# - name: my_experiment
#   workflow: [emb_clf, emb_reg]   # or a single one: emb_clf
#   # -- most-used overrides --
#   n_runs: 5
#   num_classes: 4
#   model_arch: mlp                # mlp | resmlp | ft_transformer
#   hidden: [384, 256, 128]
#   dropout: 0.5
#   lr: 0.0005
#   embedder: specter2             # specter2 | scibert | scincl | e5 | openai
#   encoder_kind: identity         # identity | autoencoder | pca | umap
#   # -- anything else from sections 1-6 works too --
#   class_weight: effective
#   patience: 80
# -----------------------------------------------------------------------------

runs:
  # ==========================================================================
  # FINAL 8-HOUR QUEUE (sized for one 16 GB-VRAM GPU, ~4-6 h expected + margin).
  # Data collection runs SEPARATELY BEFORE this queue:
  #   1. python -m workflow.src.main_extend_db bootstrap --target-rows 100000
  #   2. python -m workflow.src.main_extend_db extend
  #      (builds extended.db -> training.db -> holdout benchmark; set
  #       EPAI_DB=training in .env.workflow afterwards)
  #   3. optional: python -m workflow.src.setup_external_models   (NAIP weights)
  #   4. optional: download naip12k benchmark for the flagship entry
  # Every run gets baselines (specter2_knn, venue_ais) + the holdout benchmark
  # automatically from the top-level keys above.
  # ==========================================================================

  # -- 1-6: specter2 grid — encoder {autoencoder, identity} x depth {deep, mid, shallow}
  - name: specter2_ae_mlp_deep
    workflow: [emb_clf, emb_reg]
    embedder: specter2
    encoder_kind: autoencoder
    model_arch: mlp
    hidden: [1024,768,512,384,256,192,128,64,32]
    patience: 40
