# Python cache
__pycache__/
*.py[cod]
*$py.class

# Project artifact folders (anchored: workflow/data etc. only —
# unanchored patterns would also ignore the src/iwf/data and src/iwf/models packages)
/data/
/models/
/results/

# Generated result backups + timestamped DB backups (never commit — large, regenerable)
/results_backup_*/
*.pre_scratch_*
*.pre_scratch_*/

# Downloaded external impact-prediction systems (setup_external_models.py)
/external/

# Generated PDFs
*.pdf

# Environment file
.env.workflow
