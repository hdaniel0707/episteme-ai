# ============================================================================
# .env.workflow — MACHINE / OPERATIONAL knobs only (this PC, not the science).
#
# Everything that defines WHAT is trained (workflow, target, classes, model,
# hyperparameters) lives in workflow/config.yaml. This file only controls HOW
# this machine executes it: parallelism, GPU memory, cache invalidation.
# Secrets (OpenAI / S2 / HF / MIRAI keys) live in the repo-root .env — never here.
# ONE deliberate exception: the LLM-as-judge workflow, the extend-phase LLM auto-fill,
# and the llm_judge external-impact baseline all read their credentials from THIS file
# (LLM_JUDGE_PROVIDER/MODEL/API_KEY + LOCAL_LLM_URL, see the "LLM configuration" section
# below) so this module stays fully configurable from .env.workflow alone.
# ============================================================================

# --- parallelism / machine load -------------------------------------------
# How many seeds/jobs may train at once. auto = derive from cores + load target.
PARALLEL_JOBS=auto
# Admit new parallel workers only while CPU% and GPU% are below this fraction.
# 0.50 = keep ~half the machine free for other work (jobs already running still
# use their full share; this only throttles how many run AT ONCE).
PARALLEL_LOAD_TARGET=0.50
# torch threads per parallel worker (0 = spread the budget across the workers).
PARALLEL_THREADS_PER_WORKER=0

# --- GPU / embedding batch size (memory only, never affects results) -------
EMBED_BATCH_SIZE=32

# --- cache invalidation (expensive stages are reused when their output exists)
FORCE_FETCH=false      # true = re-download the corpus even if the parquet exists
FORCE_EMBED=false      # true = recompute embeddings (~1h) even if cached
FORCE_BENCHMARK_EMBED=false  # true = re-embed benchmark texts (e.g. holdout_extended) for
                             # every run's benchmark scoring instead of reusing the cached
                             # embedding from the first run; run_plot_refresh.py asks for
                             # this interactively instead of reading it from here

# --- BIG FEATURE TOGGLES (read by deploy_and_run.sh / deploy_and_run.ps1) ----------
# Skip whole stages / data sources. Default (all true) runs the full pipeline. Set false
# to skip a feature — e.g. reuse an existing DB (ENABLE_BOOTSTRAP/ENABLE_EXTEND_DB=false)
# or drop the slow network crawls (ENABLE_OPENALEX/ENABLE_S2=false). Accepts true/false.
ENABLE_BOOTSTRAP=true       # step 1: fresh multi-source fetch -> raw.db
ENABLE_EXTEND_DB=true       # step 2: database extension -> extended/training.db
ENABLE_ANALYSE=true         # step 3: dataset statistics
ENABLE_TRAINING=true        # step 4: run_all_workflows (training + benchmarks)
ENABLE_OPENALEX=true        # OpenAlex fetch / fill
ENABLE_S2=true              # Semantic Scholar fetch / gap-fill
ENABLE_CROSSREF=true        # Crossref fetch (bootstrap)
ENABLE_ARXIV=true           # arXiv fetch (bootstrap)
ENABLE_UEFISCDI=true        # UEFISCDI/JCR seeding (extend)
ENABLE_PDF=true             # UEFISCDI/JCR PDF extraction (extend)
ENABLE_FILL=true            # metadata gap-fill of incomplete rows (extend)
# NB: these ENABLE_* flags are now also honoured when running main_extend_db directly
# (not just via the deploy scripts) — e.g. ENABLE_S2=false gathers with OpenAlex+pdf only.

# --- database merge / dedup (main_extend_db copy phase) --------------------
# Two rows are the same paper when their normalized titles (spaces/_/- stripped,
# lowercased) are at least this similar AND their year + first author agree; the
# duplicate is dropped and its metadata merged into the row already stored.
TITLE_SIMILARITY_THRESHOLD=0.85

# --- training.db derivation (main_extend_db) -------------------------------
TRAIN_YEAR_FROM=1700        # keep only papers published in [FROM, TO] (TO inclusive)
TRAIN_YEAR_TO=2024
MAX_TRAINING_ROWS=150       # cap training.db to a seeded random subset (0 = no cap)
SELECTION_SEED=45           # seed for that random subset (reruns pick the same rows)
USE_LLM_ABSTRACTS_FOR_TRAINING=false  # include rows whose abstract was LLM-filled (source='llm')

# --- LLM configuration (shared by: llm_clf/llm_reg judge workflow, extend-phase LLM
# auto-fill below, and the llm_judge external-impact baseline in config.yaml
# `external_impact:`) --------------------------------------------------------------
# An OpenAI-compatible endpoint — local, university gateway, or cloud proxy. This client
# only speaks the OpenAI /v1/chat/completions shape, so LOCAL_LLM_URL is used regardless
# of the LLM_JUDGE_PROVIDER label (anthropic/openai select the LLMJudgeBaseline's own
# native API calls instead — see iwf/features/external_impact.py). Any of PROVIDER/MODEL/
# API_KEY/LOCAL_LLM_URL unset -> every LLM call is a no-op (returns None) and callers fall
# back to a deterministic default (e.g. the judge workflow's kNN-mean fallback); the
# pipeline never crashes for a missing endpoint.
LLM_JUDGE_PROVIDER=local          # anthropic | openai | local
LLM_JUDGE_MODEL=llama-3.1-8b-instruct   # model name/tag sent in the request body
# LLM_JUDGE_API_KEY=              # secret - bearer token for LOCAL_LLM_URL; set in YOUR
                                   # .env.workflow only, never commit a real value here
LOCAL_LLM_URL=http://localhost:11434    # base URL of the OpenAI-compatible endpoint
                                         # (this client appends /v1/chat/completions)
# Your deployed model's context-window size, in tokens. Machine/deployment-specific (not a
# "science" setting), so it lives here rather than config.yaml. Used to cap the judge
# workflow's per-record retrieval budget: system prompt + rubric + query + retrieved
# precedents together are kept within 50% of this window. 0/unset = unknown -> the
# retrieval budget is governed by JUDGE_RAG_TOKEN_BUDGET alone (no window-aware capping).
LLM_JUDGE_MAX_CONTEXT_TOKENS=0

JUDGE_RAG_TOKEN_BUDGET=3000     # max tokens of retrieved precedents per judge prediction
JUDGE_RAG_CHUNK_TOKENS=200      # max tokens per stored RAG chunk (title+abstract+impact)
# NB: the judge workflow's only per-run "science" knob is judge_max_train_papers
# (config.yaml — caps how many TRAIN papers build the RAG store, 0 = use all of TRAIN).
# The LLM is called exactly once per record (train/val/test) against a fixed rubric, no
# notes-rewriting or checkpointing (see src/main_train_judge.py).

# --- extend-phase LLM auto-fill (main_extend_db) ----------------------------
# Uses the SAME LLM configuration block above - no separate credentials. The row CAPS
# (how many domains / abstracts to fill) live in config.yaml: llm_fill_domain_max,
# llm_fill_abstract_max. Whether filled abstracts enter training: config.yaml
# use_llm_abstracts_for_training (overrides USE_LLM_ABSTRACTS_FOR_TRAINING above).
ENABLE_LLM_FILL=false            # LLM picks a domain (from ALLOWED_DOMAINS) for rows missing one
ENABLE_LLM_ABSTRACT_FILL=false   # LLM supplies missing abstract/year (sets source='llm')
ENABLE_LLM_WEBSEARCH=false       # web-search-first for the abstract fill (providers below)

# --- web search for abstract auto-fill (iwf/fetchers/websearch.py) ----------
# When ENABLE_LLM_WEBSEARCH=true, the abstract fill first looks the paper up by title in
# these FREE, NO-REGISTRATION scholarly REST APIs and hands any confident hit to the LLM to
# verify/clean, only falling back to the LLM's own knowledge when nothing is found.
# ResearchGate and similar are Cloudflare-walled and unusable programmatically; Crossref +
# Europe PMC cover the same abstracts legally without an API key.
WEBSEARCH_PROVIDERS=crossref,europepmc   # order = preference; also supports `api` (below)
WEBSEARCH_TIMEOUT=15                      # per-request seconds
WEBSEARCH_MIN_SIMILARITY=0.82            # min title-similarity (0-1) to accept a hit
# OPTIONAL keyed generic web-search fallback — OFF by default; only set if you registered a
# key AND add `api` to WEBSEARCH_PROVIDERS. WEBSEARCH_API_KEY is a secret (your file only).
WEBSEARCH_API_PROVIDER=          # tavily | serper | (empty = disabled)
# WEBSEARCH_API_KEY=

# --- desktop behaviour ------------------------------------------------------
UMAP_OPEN_BROWSER=true # open interactive 3-D UMAP HTML files after a run

# --- API politeness ---------------------------------------------------------
OPENALEX_MAILTO=szilagy.sandorzsolt@gmail.com

# --- OpenAlex daily-limit survival (main_extend_db OpenAlex collection) ------
# OpenAlex meters requests as daily credits (100k/day free, resets ~midnight UTC). If new-
# paper collection hits that limit before the target (config.yaml fetch_new_rows /
# fetch_target_rows) is met, it idles for the reset and resumes, up to config.yaml
# fetch_wait_days times. Machine knobs:
FETCH_RATE_LIMIT_WAIT_HOURS=25   # hours to idle per daily reset (holds minimal RAM)
FETCH_STALL_LIMIT=2000           # give up a session after N consecutive already-known rows
                                 # (anti-waste; a reset won't create new papers there)

# --- data source ------------------------------------------------------------
# Which SQLite DB feeds phase 0: empty = newest store/data/sql/*.db (professor's),
# a filename under store/data/sql/, an absolute path, or the literal `extended`
# for the workflow-owned workflow/data/sql/extended.db (built by main_extend_db).
# EPAI_DB=extended
# Restrict the dataset-statistics step to specific acquisition channel(s) — every plot/CSV
# it writes is filtered before being computed, re-applied automatically on every rerun.
# Independent of training_sources (config.yaml): only changes what the ANALYSIS describes.
#   openalex | s2 | crossref | arxiv | pdf | llm | any   (empty/any = every source)
# ANALYSE_SOURCES=openalex

# --- baseline scorers (config.yaml `external_impact:`) -----------------------
BASELINE_KNN_K=15                 # k for the specter2_knn retrieval baseline
# llm_judge (if added to external_impact:) uses the LLM configuration block above
# (LLM_JUDGE_PROVIDER/MODEL/API_KEY, LOCAL_LLM_URL) — no separate settings here.

# --- generated-paper scoring (main_predict_generated only) ------------------
# GENERATED_FILE=path/to/export.parquet   # local export; empty = query the API
# GENERATED_SOURCE=mirai                  # mirai | adp

# --- CLOUD / DEDICATED-BOX PROFILE (8-hour training run on a 16 GB GPU) ------
# Copy this file to .env.workflow on the training machine and uncomment:
# PARALLEL_JOBS=auto            # derive worker count from cores + free VRAM
# PARALLEL_LOAD_TARGET=0.90     # dedicated box: use (almost) everything
# EMBED_BATCH_SIZE=64           # 16 GB card handles larger embedding batches
# UMAP_OPEN_BROWSER=false       # headless machine: never try to open a browser
# EPAI_DB=training              # the strict training DB built by main_extend_db
# NAIP_WEIGHTS_DIR=             # set after setup_external_models to enable naip_local
# NAIP_BATCH=8                  # naip_local GPU batch size
