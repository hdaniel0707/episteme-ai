# ============================================================================
# .env.workflow — MACHINE / OPERATIONAL knobs only (this PC, not the science).
#
# Everything that defines WHAT is trained (workflow, target, classes, model,
# hyperparameters) lives in workflow/config.yaml. This file only controls HOW
# this machine executes it: parallelism, GPU memory, cache invalidation.
# Secrets (OpenAI / S2 / HF / MIRAI keys) live in the repo-root .env — never here.
# ============================================================================

# --- parallelism / machine load -------------------------------------------
# How many seeds/jobs may train at once. auto = derive from cores + load target.
PARALLEL_JOBS=auto
# Admit new parallel workers only while CPU% and GPU% are below this fraction.
# 0.50 = keep ~half the machine free for other work (jobs already running still
# use their full share; this only throttles how many run AT ONCE).
PARALLEL_LOAD_TARGET=0.50
# torch threads per parallel worker (0 = spread the budget across the workers).
PARALLEL_THREADS_PER_WORKER=0

# --- GPU / embedding batch size (memory only, never affects results) -------
EMBED_BATCH_SIZE=32

# --- cache invalidation (expensive stages are reused when their output exists)
FORCE_FETCH=false      # true = re-download the corpus even if the parquet exists
FORCE_EMBED=false      # true = recompute embeddings (~1h) even if cached

# --- desktop behaviour ------------------------------------------------------
UMAP_OPEN_BROWSER=true # open interactive 3-D UMAP HTML files after a run

# --- API politeness ---------------------------------------------------------
OPENALEX_MAILTO=szilagy.sandorzsolt@gmail.com

# --- generated-paper scoring (main_predict_generated only) ------------------
# GENERATED_FILE=path/to/export.parquet   # local export; empty = query the API
# GENERATED_SOURCE=mirai                  # mirai | adp
