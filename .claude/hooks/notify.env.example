# Copy to notify.env (gitignored) and fill in. Sourced by notify.sh.
#
# The ntfy topic name is the only credential: ntfy has no per-topic auth on the
# public server, so whoever knows the name can read every push and send their
# own. Treat it like a password — pick something unguessable, e.g.
#
#     echo "epai-claude-$(openssl rand -hex 6)"
#
# With no notify.env present the hook still runs (chime + desktop notification);
# it just skips the phone push.
NTFY_TOPIC=replace-me-with-an-unguessable-topic

# Optional: point at a self-hosted ntfy instance. Defaults to https://ntfy.sh.
#NTFY_SERVER=https://ntfy.example.org
