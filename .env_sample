# .env file used by load_dotenv
# copy example.env to .env

ANTHROPIC_API_KEY="XXX"
OPENAI_API_KEY="XXX"
GEMINI_API_KEY="XXX"
HF_TOKEN="XXX"
SEMANTIC_SCHOLAR_API_KEY="XXX"
OPENALEX_API_KEY = "XXX"

# GenAI4Science (HUN-REN SZTAKI) — OpenAI-compatible endpoint for open-weight
# judge / generator models. Key from Portal > Settings > Account.
#
# The code prefers the PERFORMANCE key/endpoint whenever it is set (dedicated
# capacity, max 4 concurrent calls — a 5th trips a ~1-minute key block), and
# falls back to the shared endpoint otherwise (model trials, light use).
GENAI4SCIENCE_API_KEY="XXX"
# GENAI4SCIENCE_BASE_URL="https://genai.science-cloud.hu/api"

GENAI4SCIENCE_PERFORMANCE_API_KEY="XXX"
# GENAI4SCIENCE_PERFORMANCE_BASE_URL="https://genai.science-cloud.hu/performance-api/"

# Optional. Phone notifications from the pipeline runners (ntfy), one push per
# stage plus a loud one if a run stops. Unset means no pushes at all.
#
# The topic name is the only credential — ntfy's public server has no per-topic
# auth, so anyone who knows the name can read every push. Pick an unguessable
# one and keep it out of git:
#
#     echo "epai-pipeline-$(openssl rand -hex 6)"
#
#NTFY_PIPELINE_TOPIC="epai-pipeline-XXXXXXXXXXXX"
# Optional: a self-hosted ntfy instance. Defaults to https://ntfy.sh.
#NTFY_SERVER="https://ntfy.example.org"

